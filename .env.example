VITE_DEMO_MODE=false
VITE_MAP_PROVIDER=osm
VITE_GOOGLE_MAPS_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PUBLIC_SITE_URL=https://roadtag.org
# Optional alternate OSM-compatible tile provider (attribution must also be reviewed)
VITE_OSM_TILE_URL=
# Server-only secrets: never prefix these with VITE_. Set the same gate secret in Supabase Edge.
UPLOAD_GATE_SECRET=
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# TGOS server-only. Leave disabled until authenticated transport is verified.
TGOS_APP_ID=
TGOS_API_KEY=
TGOS_LOCATION_ENABLED=false
# MCP Phase 1A: server-only, disabled; isolated project only until code review.
MCP_ENABLED=false
# Legacy alpha is independent of OAuth; keep absent/false in Production.
MCP_LEGACY_ALPHA_ENABLED=false
MCP_OAUTH_ENABLED=false
MCP_PUBLIC_ORIGIN=
MCP_SUPABASE_URL=
MCP_SUPABASE_PUBLISHABLE_KEY=
MCP_SUPABASE_SERVICE_KEY=
MCP_SESSION_ENCRYPTION_KEY=
MCP_PHOTO_SECRET=
# JSON array of id, actor, write, credentialHash. Sessions are encrypted in private SQL storage.
MCP_PRINCIPALS_JSON=

MCP_OAUTH_PRINCIPALS_JSON=
MCP_OAUTH_CLIENTS_JSON=
VITE_MCP_OAUTH_ENABLED=false

# P2A public read-only MCP: Preview/local only; independent of Alpha OAuth.
MCP_PUBLIC_READ_ENABLED=false
MCP_PUBLIC_READ_ORIGIN=
MCP_PUBLIC_READ_SUPABASE_URL=
MCP_PUBLIC_READ_SUPABASE_PUBLISHABLE_KEY=
# Independent quota-only capability; never reuse Alpha/photo/upload secrets.
# Provision SHA-256 hash into staging private.mcp_public_control while disabled.
MCP_PUBLIC_CONTROL_SECRET=

# Production uses a separate lane; Preview/Staging values never activate it.
MCP_PUBLIC_PRODUCTION_READ_ENABLED=false
MCP_PUBLIC_PRODUCTION_READ_ORIGIN=https://roadtag.org
MCP_PUBLIC_PRODUCTION_READ_SUPABASE_URL=https://ifcicahnrpkwjcxmnmug.supabase.co
MCP_PUBLIC_PRODUCTION_READ_SUPABASE_PUBLISHABLE_KEY=
MCP_PUBLIC_PRODUCTION_CONTROL_SECRET=
# Public addresses stay off even when the private Alpha provider is enabled.
MCP_PUBLIC_PRODUCTION_GEOCODING_ENABLED=false
# Non-secret homepage release status. Keep false until the public release is approved.
VITE_MCP_PUBLIC_RELEASED=false
