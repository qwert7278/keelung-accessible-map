{
  "name": "keelung-accessible-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-seo.mjs && node scripts/seo-check.mjs",
    "lint": "eslint .",
    "test": "vitest run && node scripts/location-runtime-check.mjs && node scripts/upload-runtime-check.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:db": "node scripts/db-launch-check.mjs",
    "test:storage": "node scripts/storage-upload-integration.mjs",
    "test:mcp": "tsx tests/mcp-phase1a.ts && tsx tests/mcp-hosted-auth.ts && node scripts/mcp-runtime-check.mjs",
    "mcp:local": "tsx scripts/mcp-local.ts",
    "test:mcp:oauth": "tsx tests/mcp-oauth.ts && tsx tests/mcp-attachment-probe.ts && tsx tests/mcp-attachment-download.ts && tsx tests/mcp-attachment-photo.ts && tsx tests/mcp-attachment-write.ts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@modelcontextprotocol/server": "2.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "2.117.2",
    "gsap": "3.15.0",
    "heic-to": "1.6.5",
    "idb-keyval": "^6.3.0",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.3",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/google.maps": "^3.66.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
