{
  "name": "keelung-accessible-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/build-seo.mjs && node scripts/seo-check.mjs",
    "lint": "eslint .",
    "test": "vitest run && node scripts/location-runtime-check.mjs && node scripts/upload-runtime-check.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:db": "node scripts/db-launch-check.mjs"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "2.117.2",
    "heic-to": "1.6.5",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.3",
    "@eslint/js": "^10.0.1",
    "@types/google.maps": "^3.66.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
