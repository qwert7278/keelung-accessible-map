{
  "https://roadtag.org/": [
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://roadtag.org/#website",
      "url": "https://roadtag.org/",
      "name": "路見不平",
      "alternateName": "Road Tag",
      "description": "路見不平，一起標註。以台灣騎樓與人行道為核心，查看與標註通行障礙，留下現場照片與改善紀錄。",
      "inLanguage": "zh-Hant-TW"
    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "@id": "https://roadtag.org/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "這個平台主要回報哪些問題？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "路見不平以騎樓與人行道為核心，記錄高低差、路面破損、通道阻塞、缺乏坡道等通行障礙，並留下位置、照片及現場說明。"
          }
        },
        {
          "@type": "Question",
          "name": "可以選擇哪些縣市？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "地圖提供台灣 22 個縣市與 368 個行政區的選擇，初次使用從基隆市仁愛區開始。台灣 22 個縣市與 368 個行政區均可回報騎樓及人行道通行障礙。"
          }
        },
        {
          "@type": "Question",
          "name": "回報會自動送交政府嗎？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "目前不會。這是民眾共同紀錄平台，尚未串接政府派工。社群回報與案件狀態不代表政府公告，也不保證路線安全。"
          }
        },
        {
          "@type": "Question",
          "name": "為什麼切換縣市後先顯示某個行政區？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "每個縣市先設定一個中心行政區作為瀏覽起點，例如基隆市仁愛區、臺北市中山區。這是操作起點，不是人流或改善需求排名；你可以切換其他行政區。"
          }
        }
      ]
    },
