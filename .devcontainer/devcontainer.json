{
  "name": "Road Tag 雲端開發",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "remoteUser": "node",
  "remoteEnv": {
    "VITE_DEMO_MODE": "true",
    "VITE_MAP_PROVIDER": "osm"
  },
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Road Tag 開發預覽",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm ci",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint"
      ],
      "settings": {
        "files.eol": "\n"
      }
    }
  }
}
