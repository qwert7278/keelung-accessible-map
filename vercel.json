{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/oauth/consent", "destination": "/oauth-consent.html" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp-oauth-resource" },
    { "source": "/.well-known/oauth-protected-resource/api/mcp-chatgpt", "destination": "/api/mcp-oauth-resource" },
    { "source": "/map", "destination": "/map.html" },
    { "source": "/admin", "destination": "/map.html" },
    { "source": "/how-to", "destination": "/how-to/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" }
  ],
  "headers": [
    { "source": "/oauth/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }, { "key": "Referrer-Policy", "value": "no-referrer" }] },
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/admin/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }] },
    { "source": "/(.*)", "headers": [
    { "key": "X-Content-Type-Options", "value": "nosniff" },
    { "key": "X-Frame-Options", "value": "DENY" },
    { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
    { "key": "Permissions-Policy", "value": "geolocation=(self), camera=(), microphone=()" }
  ] }
  ],
  "crons": [{ "path": "/api/photo-cleanup", "schedule": "0 3 * * *" }]
}
